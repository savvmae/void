# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored - never commit real keys.
#
# Create React App only exposes variables prefixed with REACT_APP_,
# and it inlines them into the JavaScript bundle at build time.
# Restart `npm start` after changing this file.

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
# Dashboard -> Project Settings -> API -> Project URL
REACT_APP_SUPABASE_URL=

# Supabase anon / public key.
# Dashboard -> Project Settings -> API -> Project API keys -> anon public
# This one is safe in the browser bundle. Row level security on the
# `answers` table is what enforces access.
REACT_APP_SUPABASE_ANON_KEY=

# NOT USED BY THE FRONTEND, and must never be added here:
#   - the service role key
#   - ANTHROPIC_API_KEY
# Both live only on the server side. See README.md for how to set
# ANTHROPIC_API_KEY as a Supabase secret for the edge function.
